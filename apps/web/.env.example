# Copy to apps/web/.env and fill in. Nothing here is a real secret.

# PostgreSQL (Homebrew: createdb collabdocs)
DATABASE_URL="postgresql://localhost:5432/collabdocs"

# Redis, used by the collab server from J-T2 (Homebrew: brew services start redis)
REDIS_URL="redis://localhost:6379"

# Signs the messages on the Redis channels (membership changes, the collab servers' relay),
# so that access to Redis alone cannot inject updates or disconnect users. At least 32
# bytes, different from COLLAB_TOKEN_SECRET. The web app and every collab server need
# the same value. Required when REDIS_URL is set: the web app refuses to start without it.
REDIS_MESSAGE_SECRET=""

# Auth.js. Generate each secret with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Email. Verification links are sent through the Mailer in lib/mailer.ts.
# "console" prints them (development, the default outside production); "file" writes them
# to MAIL_OUTBOX_DIR (tests). Neither delivers mail: in production, add a transport for
# your provider (see SECURITY.md) and set it here; with this unset, production refuses to send.
# MAIL_TRANSPORT="console"
# MAIL_OUTBOX_DIR=""

# Rate limits on sign-in, registration and verification mail (defaults shown; counted
# per client address and per account, in Redis when REDIS_URL is set).
# AUTH_LIMIT_SIGNIN_PER_IP="30"            # per 15 minutes
# AUTH_LIMIT_SIGNIN_PER_ACCOUNT="10"       # per 15 minutes
# AUTH_LIMIT_REGISTER_PER_IP="10"          # per hour
# AUTH_LIMIT_REGISTER_PER_ACCOUNT="3"      # per hour
# AUTH_LIMIT_VERIFY_RESEND_PER_ACCOUNT="3" # per hour
# AUTH_LIMIT_INVITE_PER_USER="30"          # per hour
# AUTH_LIMIT_INVITE_PER_ADDRESS="5"        # per hour
# How many proxies in front of the app add to X-Forwarded-For (0 ignores the header;
# unset or empty means 1). IPv6 clients are counted per /64.
# TRUSTED_PROXY_HOPS="1"

# GitHub OAuth app (callback URL: http://localhost:3000/api/auth/callback/github).
# Leave both empty to disable the GitHub button.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Signs the short-lived collaboration tokens. At least 32 bytes, and it must differ
# from AUTH_SECRET. The collab server needs the same value to verify them.
COLLAB_TOKEN_SECRET=""
# Token lifetime in seconds (default 300, maximum 900).
COLLAB_TOKEN_TTL_SECONDS="300"

# Where the browser reaches the collab server (read when a page is rendered).
# COLLAB_URL="http://localhost:4000"

# --- Collab server (apps/collab) -------------------------------------------------
# It reads DATABASE_URL, REDIS_URL and COLLAB_TOKEN_SECRET from the environment too.
# Without REDIS_URL it runs alone: no adapter, no membership channel.
# COLLAB_PORT="4000"
# COLLAB_CORS_ORIGIN="http://localhost:3000"
# Limits (defaults shown)
# COLLAB_MAX_UPDATE_BYTES="1048576"
# COLLAB_MAX_AWARENESS_BYTES="8192"
# COLLAB_MAX_MESSAGES_PER_SECOND="100"
# COLLAB_MESSAGE_BURST="200"
# COLLAB_MAX_BYTES_PER_SECOND="262144"
# COLLAB_BYTE_BURST="2097152"
# COLLAB_MAX_DOCUMENT_BYTES="16777216"
# COLLAB_MAX_PENDING_BYTES="8388608"
# COLLAB_MAX_CONNECTIONS_PER_DOCUMENT="250"
# COLLAB_MAX_CONNECTIONS_PER_USER="8"
# COLLAB_HANDSHAKE_BURST_PER_USER="20"
# COLLAB_HANDSHAKES_PER_SECOND_PER_USER="1"
# COLLAB_HANDSHAKE_BURST_PER_IP="100"
# COLLAB_HANDSHAKES_PER_SECOND_PER_IP="5"
# COLLAB_MAX_BYTES_PER_SECOND_PER_USER="524288"
# COLLAB_BYTE_BURST_PER_USER="4194304"
# COLLAB_MAX_IN_FLIGHT_BYTES="67108864"
# COLLAB_MAX_PENDING_STRUCT_BYTES="1048576"
# Proxies in front of the collab server that append to X-Forwarded-For (0 uses the socket's address).
# COLLAB_TRUSTED_PROXY_HOPS="0"
# COLLAB_REDIS_CONNECT_TIMEOUT_MS="5000"
# Persistence (defaults shown, milliseconds where named)
# COLLAB_COMPACT_EVERY_UPDATES="200"
# COLLAB_COMPACT_AFTER_MS="30000"
# COLLAB_UNLOAD_GRACE_MS="30000"
# COLLAB_RECONCILE_INTERVAL_MS="5000"
# COLLAB_MEMBERSHIP_RECHECK_MS="60000"
# COLLAB_ROLE_CACHE_MS="1000"
