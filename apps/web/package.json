{
  "name": "@collabdocs/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@collabdocs/shared": "*",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@tiptap/extension-collaboration": "3.35.0",
    "@tiptap/extension-collaboration-caret": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "@tiptap/y-tiptap": "3.3.1",
    "ioredis": "5.11.1",
    "lib0": "0.2.120",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io-client": "4.8.4",
    "y-indexeddb": "9.0.12",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.0.0",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.33",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5"
  }
}
